# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# --- Языковая модель (OpenAI-совместимый API, по умолчанию OpenRouter) ---
# Ключ доступа (нужен для ответов модели; без него бот запускается, но LLM не работает).
# Пример вымышленный: sk-or-v1-0000000000000000
OPENROUTER_API_KEY=
# Адрес API без ключа и логина; запросы идут на <адрес>/chat/completions.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель должна поддерживать system-сообщения и параметр temperature.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Необязательный HTTP/SOCKS5-прокси только для запросов к LLM (отдельно от Telegram).
LLM_PROXY_URL=
# Таймаут одного запроса к модели, секунды (5–600).
LLM_TIMEOUT_SECONDS=60
# Максимум токенов в ответе модели (64–32000).
LLM_MAX_TOKENS=2000

# --- История диалога ---
# Сколько последних сообщений (вопросы + ответы) передавать модели (2–200).
HISTORY_MAX_MESSAGES=20
# Предельный объём запроса в символах: промпт + история + текущее сообщение (8000–200000).
HISTORY_MAX_CHARS=12000

# --- ЛР2: MCP-сервер (запускается ботом автоматически как дочерний процесс) ---
# Файл расписания (путь относительно корня проекта). Модель и пользователь путь не задают.
SCHEDULE_FILE=data/schedule.json
# Часовой пояс расписания (IANA) — для «сегодня/завтра» и ресурса schedule://current-week.
SCHEDULE_TIMEZONE=Europe/Moscow
# Таймаут одного вызова MCP-инструмента, секунды (2–120).
MCP_CALL_TIMEOUT_SECONDS=20
# Необязательно: адреса Open-Meteo (по умолчанию официальные; меняются только для тестов).
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
